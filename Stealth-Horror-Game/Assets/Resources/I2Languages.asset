        \u0441\u0435\u0441\u0442\u0440\u0435\u043D\u043A\u0430 \u0414\u0436\u0435\u0441\u0441\u0438?
        \u0415\u0439 \u0431\u044B\u043B\u043E \u0442\u044F\u0436\u0435\u043B\u0435\u0435
        \u0432\u0441\u0435\u0445. \u041E\u043D\u0430 \u043F\u043E\u043C\u043D\u0438\u0442
        \u043C\u0430\u043C\u0443 \u0435\u0449\u0435 \u0432 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438:
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u043D\u0438
        \u043C\u044B \u043D\u0435 \u0431\u0440\u0430\u043B\u0438 \u0435\u0435 \u0432
        \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443, \u043F\u043E\u0442\u043E\u043C\u0443
        \u0447\u0442\u043E \u043C\u0430\u043C\u0430 \u043F\u0443\u0433\u0430\u043B\u0430,
        \u0431\u0440\u0435\u0434\u0438\u043B\u0430, \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
        \u0436\u0443\u0442\u043A\u0438\u0435 \u0432\u0435\u0449\u0438. \u0411\u043E\u043B\u0435\u0437\u043D\u044C
        \u0441\u0442\u0435\u0440\u043B\u0430 \u0435\u0435 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C.
        \u0415\u0435 \u0445\u0443\u0434\u0430\u044F \u0438\u0437\u043C\u043E\u0436\u0434\u0435\u043D\u043D\u0430\u044F
        \u0433\u0440\u0443\u0434\u044C \u0445\u0440\u0438\u043F\u0435\u043B\u0430,
        \u0431\u0435\u043B\u044B\u0435 \u0442\u043E\u043D\u043A\u0438\u0435 \u0440\u0443\u043A\u0438
        \u0431\u044B\u043B\u0438 \u0438\u0441\u0447\u0435\u0440\u0447\u0435\u043D\u044B
        \u0442\u0435\u043C\u043D\u044B\u043C\u0438 \u0432\u0435\u043D\u0430\u043C\u0438,
        \u043D\u0430 \u0438\u0441\u0441\u043E\u0445\u0448\u0435\u043C \u043B\u0438\u0446\u0435
        \u043F\u0443\u043B\u044C\u0441\u0438\u0440\u043E\u0432\u0430\u043B\u0438
        \u0436\u0438\u043B\u044B. \u0412 \u043A\u0430\u0436\u0434\u043E\u043C \u0432\u0437\u0434\u043E\u0445\u0435
        \u043E\u0449\u0443\u0449\u0430\u043B\u0430\u0441\u044C \u0431\u0435\u0437\u0434\u043D\u0430
        \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F \u0438 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u0430\u044F
        \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C. \u0412\u0440\u0435\u043C\u044F
        \u0442\u044F\u043D\u0443\u043B\u043E\u0441\u044C \u0432\u0434\u0432\u043E\u0435
        \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435. \u041D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E
        \u043A\u0430\u043A \u043C\u0430\u043C\u0430 \u043E\u0449\u0443\u0449\u0430\u043B\u0430
        \u0432\u0440\u0435\u043C\u044F \u0442\u043E\u0433\u0434\u0430, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u0435\u0439 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
        \u043E\u043D\u0430 \u0432 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
        \u043B\u043E\u0432\u0443\u0448\u043A\u0435 \u043C\u0443\u0447\u0435\u043D\u0438\u0439.
        \u0412 \u0442\u043E\u0442 \u0434\u0435\u043D\u044C \u043E\u043D\u0430 \u043D\u0435
        \u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0438 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430
        \u043D\u0430\u0441 \u0432 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0445
        \u0430\u0433\u043E\u043D\u0438\u0438. \u041E\u043D\u0430 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435.
        \u042F \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0443\u043B\u043E\u0432\u0438\u0442\u044C
        \u043C\u0438\u0433, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043A
        \u043D\u0435\u0439 \u0432\u0435\u0440\u043D\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u0443\u043C.
        \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u0440\u0430\u0437 \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0432\u0434\u043E\u0445\u043D\u0443\u043B\u0430,
        \u044F \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
        \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u0435, \u0445\u043E\u0442\u044C
        \u0438 \u0441\u0442\u044B\u0434\u043D\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0430\u0442\u044C
        \u044D\u0442\u043E. \u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u043E\u043D\u0430
        \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043B\u0430\u0441\u044C
        \u043E\u0442 \u043C\u0443\u0447\u0435\u043D\u0438\u0439, \u0435\u0435 \u0431\u043E\u0440\u044C\u0431\u0430
        \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043D\u0435\u0434\u0435\u043B\u0438
        \u0431\u044B\u043B\u0430 \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E\u0439.
        \u042F \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443 \u044D\u0442\u0443
        \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443 \u0438 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C
        \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C
        \u0442\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u043D\u0438
        \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435. \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
        \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043C\u043E\u0438
        \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F
        \u043F\u043E\u0431\u043B\u0435\u043A\u043D\u0443\u0442. \u042F \u0431\u0443\u0434\u0443
        \u043F\u043E\u043C\u043D\u0438\u0442\u044C \u043C\u0430\u043C\u0443 \u0442\u0430\u043A\u043E\u0439."
      Flags: 0000
      Languages_Touch: []
    - Term: Diary_2
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u041D\u0430\u0448 \u0434\u043E\u043C \u0431\u044B\u043B \u043C\u0435\u0441\u0442\u043E\u043C
        \u0442\u0435\u043F\u043B\u044B\u0445 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439
        \u043A\u043E\u0433\u0434\u0430-\u0442\u043E, \u0442\u0435\u043F\u0435\u0440\u044C
        \u043E\u043D \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u043B \u043D\u0430\u043C
        \u0440\u0430\u043D\u044B. \u041C\u044B \u0440\u0435\u0448\u0438\u043B\u0438
        \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u0442\u044C. \u041C\u044B \u0432\u0441\u0435
        \u0445\u043E\u0442\u0435\u043B\u0438 \u044D\u0442\u043E\u0433\u043E. \u0427\u0442\u043E
        \u0436, \u043F\u043E\u0440\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C
        \u043D\u043E\u0432\u0443\u044E \u0436\u0438\u0437\u043D\u044C. \u042F \u0437\u0430\u0439\u043C\u0443\u0441\u044C
        \u0434\u0435\u043B\u0430\u043C\u0438 \u043F\u043E \u0434\u043E\u043C\u0443.
        \u041F\u043B\u0430\u043D\u044B \u043D\u0435 \u0433\u0440\u0430\u043D\u0434\u0438\u043E\u0437\u043D\u044B\u0435,
        \u043D\u043E \u043D\u0430\u0434\u043E \u0436\u0435 \u0441 \u0447\u0435\u0433\u043E-\u0442\u043E
        \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C:\n1. \u0420\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C \u043F\u043E
        \u0442\u0440\u0438 \u043A\u043E\u0440\u043E\u0431\u043A\u0438.\n2. \u0421\u0434\u0435\u043B\u0430\u0442\u044C
        \u0443\u0436\u0438\u043D \u043A \u043F\u0440\u0438\u0435\u0437\u0434\u0443
        \u043F\u0430\u043F\u044B.\n3. \u0420\u0430\u0437\u0432\u0435\u0441\u0438\u0442\u044C
        \u0441\u0432\u043E\u044E \u043E\u0434\u0435\u0436\u0434\u0443 \u0432 \u0448\u043A\u0430\u0444\u0443,
        \u0445\u043E\u0442\u044F \u0431\u044B \u0447\u0430\u0441\u0442\u044C.\n4.
        \u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C \u0442\u0435\u043C\u0443
        \u043F\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u0438."
      Flags: 0000
      Languages_Touch: []
    - Term: D1_Diary_Questionnaire_1
      TermType: 0
      Description: 
      Languages:
      - 
      - "1. \u0422\u0432\u043E\u0435 \u0438\u043C\u044F, \u0444\u0430\u043C\u0438\u043B\u0438\u044F
        \u0438 \u0432\u043E\u0437\u0440\u0430\u0441\u0442? - \u042D\u043B\u0438\u0441
        \u0414\u0435\u0440\u0431\u0438, 14 \u043B\u0435\u0442\n2. \u0426\u0432\u0435\u0442
        \u0433\u043B\u0430\u0437/\u0432\u043E\u043B\u043E\u0441? - \u041A\u0430\u0440\u0438\u0435/\u043A\u0430\u0448\u0442\u0430\u043D\u043E\u0432\u044B\u0435\n3
        \u0422\u0432\u043E\u0439 \u0440\u043E\u0441\u0442? - 1.63\n4 \u041B\u044E\u0431\u0438\u043C\u044B\u0439
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432 \u0448\u043A\u043E\u043B\u0435?
        - \u0411\u0438\u043E\u043B\u043E\u0433\u0438\u044F\n5. \u041B\u044E\u0431\u0438\u043C\u044B\u0439
        \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A? - \u0425\u044D\u043B\u043B\u043E\u0443\u0438\u043D\n6.
        \u041B\u044E\u0431\u0438\u043C\u044B\u0435 \u0438\u043C\u044F? - \u0412\u0435\u0440\u043E\u043D\u0438\u043A\u0430\n7.
        \u041B\u044E\u0431\u0438\u043C\u044B\u0439 \u0446\u0432\u0435\u0442? - \u0417\u0435\u043B\u0435\u043D\u044B\u0439\n8.
        \u041B\u044E\u0431\u0438\u043C\u043E\u0435 \u0431\u043B\u044E\u0434\u043E?
        - \u041F\u0438\u0446\u0446\u0430\n9. \u041B\u044E\u0431\u0438\u043C\u043E\u0435
        \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435? - \u0414\u0435\u043B\u044C\u0444\u0438\u043D\n10.
        \u0427\u0435\u043C \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F
        \u0432 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F?
        - \u0421\u043B\u0443\u0448\u0430\u044E \u043C\u0443\u0437\u044B\u043A\u0443,
        \u0441\u043C\u043E\u0442\u0440\u044E \u0442\u043E\u043A-\u0448\u043E\u0443\n11.
        \u041A\u0435\u043C \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0441\u0442\u0430\u0442\u044C?
        - \u0412\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043E\u043C\n12.
        \u041A\u0443\u0434\u0430 \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0448\u044C
        \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u044C? - \u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442
        \u0421\u0432\u044F\u0442\u043E\u0433\u043E \u042D\u0434\u0432\u0430\u0440\u0434\u0430\n13.
        \u0422\u044B \u0432 \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0432\u043B\u044E\u0431\u043B\u0435\u043D\u0430? - \u041D\u0435\u0442\n14.
        \u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043F\u0430\u0440\u0435\u043D\u044C?
        - \u0414\u0430\n15. \u0422\u044B \u0432\u0435\u0440\u0438\u0448\u044C \u0432
        \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u043B\u044E\u0431\u043E\u0432\u044C?
        - \u041D\u0435\u0442\n16. \u041A\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0435
        \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0432 \u0448\u043A\u043E\u043B\u0435?
        - \u041D\u0438\u043A\u0442\u043E\n17. \u0427\u0442\u043E \u0434\u043B\u044F
        \u0442\u0435\u0431\u044F \u0441\u0447\u0430\u0441\u0442\u044C\u0435? - \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
        \u0432 \u043A\u0440\u0443\u0438\u0437\n18. \u0427\u0435\u0433\u043E \u0442\u044B
        \u0431\u043E\u0438\u0448\u044C\u0441\u044F? - \u0423\u0442\u043E\u043D\u0443\u0442\u044C\n19.
        \u0422\u0432\u043E\u044F \u043B\u0443\u0447\u0448\u0430\u044F \u043F\u043E\u0434\u0440\u0443\u0433\u0430?
        - \u0422\u044B \u2661\n20. \u041F\u043E\u0436\u0435\u043B\u0430\u043D\u0438\u0435
        \u0445\u043E\u0437\u044F\u0439\u043A\u0435 \u0430\u043D\u043A\u0435\u0442\u044B
        \u2014 \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0442\u044B \u043C\u0435\u0447\u0442\u0430\u0435\u0448\u044C
        \u043E \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u043C\u0430\u043C\u0430
        \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u044B\u0437\u0434\u043E\u0440\u043E\u0432\u0438\u043B\u0430.
        \u042F \u0442\u043E\u0436\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0443
        \u044D\u0442\u043E\u0433\u043E."
      Flags: 0000
      Languages_Touch: []

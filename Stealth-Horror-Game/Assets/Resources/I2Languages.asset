    - Term: Dialogue System/Conversation/D1_Dialogue_Sister/Entry/1/Sister/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u041E\u0447\u0435\u043D\u044C \u0432\u043A\u0443\u0441\u043D\u043E \u043F\u0430\u0445\u043D\u0435\u0442.
        \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437,
        \u043E\u0431\u0435\u0449\u0430\u044E, \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0443
        \u0442\u0435\u0431\u0435."
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/D1_Dialogue_Sister/Entry/2/Ann/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C.
        \u041A\u0430\u043A \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430
        \u043A \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439?"
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/D1_Dialogue_Sister/Entry/3/Sister/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E. \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E."
      Flags: 0000
      Languages_Touch: []
    - Term: Introduction
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0412 \u043F\u0440\u043E\u0448\u043B\u044B\u0435 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435
        \u043F\u0440\u043E\u0448\u043B\u043E \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435
        \u0441 43-\u0445 \u043B\u0435\u0442\u043D\u0435\u0439 \u0414\u0435\u0431\u043E\u0440\u043E\u0439,
        \u0436\u0435\u043D\u043E\u0439 \u0438 \u043C\u0430\u0442\u0435\u0440\u044C\u044E
        \u0434\u0432\u0443\u0445 \u0434\u043E\u0447\u0435\u0440\u0435\u0439. \u041F\u043E\u0441\u043B\u0435
        \u043F\u043E\u0445\u043E\u0440\u043E\u043D \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C
        \u043E\u0442\u0446\u0430 \u0424\u0440\u044D\u043D\u043A\u0430 \u0431\u044B\u043B
        \u043F\u0440\u043E\u0434\u0430\u043D \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439
        \u0434\u043E\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0443\u0441\u043E\u043F\u0448\u0430\u044F
        \u0431\u043E\u0440\u043E\u043B\u0430\u0441\u044C \u0441\u043E \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0439
        \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E, \u043F\u043E\u043A\u0430
        \u0435\u0435 \u043E\u043F\u044F\u0442\u044C \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438
        \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443 \u2014 \u0432 \u044D\u0442\u043E\u0442
        \u0440\u0430\u0437 \u0436\u0434\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
        \u0434\u043D\u044F. \u0412 \u044D\u0442\u0438\u0445 \u0440\u043E\u0434\u043D\u044B\u0445
        \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0441\u0442\u0435\u043D\u0430\u0445
        \u043E\u043D\u0430 \u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430, \u0430
        \u0438\u043D\u043E\u0433\u0434\u0430 \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u043B\u0430\u0441\u044C
        \u043D\u0430\u0434\u0435\u0436\u0434\u043E\u0439, \u0437\u0430\u0442\u0435\u043C
        \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u043B\u0430\u0441\u044C
        \u0432 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0435. \u0418 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F
        \u0438\u0441\u0445\u043E\u0434, \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
        \u0432 \u0434\u043E\u043C\u0435 \u0441\u0442\u0430\u043B\u043E \u043D\u0435\u0432\u044B\u043D\u043E\u0441\u0438\u043C\u043E.
        \u0414\u043E\u043C \u043D\u043E\u043C\u0435\u0440 1428 \u042D\u043B\u043C
        \u0421\u0442\u0440\u0438\u0442 \u043F\u0430\u0440\u0443 \u043B\u0435\u0442
        \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u043B\u0441\u044F \u043F\u043E\u043A\u043E\u0435\u043C.
        \u041E\u0441\u0435\u043D\u044C\u044E 1986 \u0433\u043E\u0434\u0430 \u0435\u043C\u0443
        \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u044C
        \u0432 \u0441\u0432\u043E\u0435 \u043D\u0443\u0442\u0440\u043E \u043D\u043E\u0432\u044B\u0445
        \u0436\u0438\u0442\u0435\u043B\u0435\u0439."
      Flags: 0000
      Languages_Touch: []
    - Term: D1_Ann_0
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u041F\u0430\u0440\u0443 \u0434\u043D\u0435\u0439 \u043C\u044B \u0436\u0438\u0432\u0435\u043C
        \u0437\u0434\u0435\u0441\u044C, \u043D\u043E \u0432 \u0434\u043E\u043C\u0435
        \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
        \u2014 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0431\u043A\u0438
        \u043D\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043D\u043E\u2026
        \u0421\u0434\u0435\u043B\u0430\u044E \u0437\u0430\u043F\u0438\u0441\u0438
        \u0432 \u0441\u0432\u043E\u0435\u043C \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0435
        \u0438 \u043F\u043E\u0440\u0430 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0442\u044C
        \u043A \u0434\u0435\u043B\u0443\xBB."
      Flags: 0000
      Languages_Touch: []
    - Term: D1_F2_Room_Wardrobe_1
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0412 \u043C\u043E\u0435\u0439 \u043F\u0440\u0435\u0436\u043D\u0435\u0439
        \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0442\u043E\u0436\u0435 \u0431\u044B\u043B
        \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \u0448\u043A\u0430\u0444.
        \u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043C\u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
        \u0447\u0442\u043E \u0442\u0430\u043C \u0437\u0430\u0442\u0430\u0438\u043B\u0441\u044F
        \u043C\u043E\u043D\u0441\u0442\u0440. \u042F \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0430
        \u0434\u0432\u0435\u0440\u0446\u044B \u0438 \u0441\u0442\u0430\u0432\u0438\u043B\u0430
        \u043D\u043E\u0447\u043D\u0438\u043A \u043D\u0430 \u043F\u043E\u043B \u0440\u044F\u0434\u043E\u043C
        \u0441 \u043D\u0438\u043C, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E

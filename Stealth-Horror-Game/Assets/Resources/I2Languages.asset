    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/2/Ann/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u041E, \u043F\u0440\u0438\u0432\u0435\u0442, \u042D\u043B\u0438\u2026"
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/3/Elisabeth/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0421\u043B\u0443\u0448\u0430\u0439, \u044F \u0442\u0435\u0431\u0435 \u0441\u0435\u0439\u0447\u0430\u0441
        \u0442\u0430\u043A\u043E\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443.
        \u0420\u043E\u0431\u0435\u0440\u0442, \u043E\u043D \u0441 \u0434\u0440\u0443\u0433\u043E\u043C
        \u043F\u043E\u0434\u043E\u0448\u0435\u043B \u043A\u043E \u043C\u043D\u0435,
        \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C?
        \u041D\u0443, \u0442\u0430\u043C \u0431\u044B\u043B\u043E \u0435\u0449\u0435
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u0432\u0447\u043E\u043D\u043E\u043A,
        \u043D\u043E \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0442\u043E\u043B\u044C\u043A\u043E
        \u043D\u0430 \u043C\u0435\u043D\u044F. "
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/4/Elisabeth/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0441\u043A\u043E\u0440\u043E
        \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
        \u0432 \u043F\u0430\u0440\u043A\u0435 \u0430\u0442\u0442\u0440\u0430\u043A\u0446\u0438\u043E\u043D\u043E\u0432.
        \u0418 \u043E\u043D \u0441\u043C\u043E\u0436\u0435\u0442 \u043A\u0430\u0442\u0430\u0442\u044C
        \u043D\u0430\u0441 \u0432\u0441\u0435\u0445 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0443\u0433\u043E\u0434\u043D\u043E \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E,
        \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C?
        \u0411\u043E\u0436\u0435, \u043E\u043D \u0442\u0430\u043A\u043E\u0439 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439!"
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/5/Ann/Dialogue Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u042D\u043B\u0438\u2026"
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/6/Elisabeth/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0422\u0430\u043C \u0441\u0442\u043E\u044F\u043B\u0430 \u0435\u0449\u0435
        \u044D\u0442\u0430 \u0421\u0430\u0440\u0430, \u0434\u0440\u044F\u043D\u044C.
        \u041E\u043D\u0430 \u0432\u0441\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u0438 \u0443\u043B\u044B\u0431\u0430\u043B\u0430\u0441\u044C \u041C\u041E\u0415\u041C\u0423
        \u0420\u041E\u0411\u0415\u0420\u0422\u0423! "
      Flags: 0000
      Languages_Touch: []
    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/7/Elisabeth/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0418 \u0435\u0449\u0435, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C,
        \u0414\u0430\u0439\u0430\u043D! \u041E\u043D\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0430\u0441\u044C
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F, \u0447\u0442\u043E \u0435\u0439
        \u0442\u043E\u0436\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
        \u0420\u043E\u0431\u0435\u0440\u0442! "
      Flags: 0000

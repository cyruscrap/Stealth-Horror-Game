    - Term: N1_Ann_1
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u041E\u043D\u0430 \u043F\u043B\u0430\u0447\u0435\u0442 \u0442\u0430\u043A
        \u043F\u043E\u0447\u0442\u0438 \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C.
        \u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
        \u0435\u0435 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C, \u0438
        \u043F\u0435\u0440\u0432\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043E\u043D\u0430
        \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B\u0430 \u043C\u043E\u0435
        \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0434\u043D\u0435\u0439 \u043D\u0430\u0437\u0430\u0434 \u043E\u043D\u0430
        \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u043C\u0435\u043D\u044F
        \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0435 \u043E\u0434\u043D\u0443.
        \u042F \u043D\u0435 \u0431\u0443\u0434\u0443 \u043C\u0435\u0448\u0430\u0442\u044C
        \u0435\u0439. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044D\u0442\u043E
        \u043F\u0443\u0442\u044C \u043A \u0435\u0435 \u0438\u0441\u0446\u0435\u043B\u0435\u043D\u0438\u044E..."
      Flags: 0000
      Languages_Touch: []

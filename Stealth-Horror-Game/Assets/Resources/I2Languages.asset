    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/1/Elisabeth/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0410\u043B\u043B\u043E, \u042D\u043D\u043D\u0438-\u0438-\u0438, \u043F\u0440\u0438\u0432\u0435\u0442.
        \u042D\u0442\u043E \u042D\u043B\u0438\u0437\u0430\u0431\u0435\u0442. \u041D\u0443
        \u043A\u0430\u043A \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C? \u041A\u0430\u043A
        \u0442\u0430\u043C \u043F\u0440\u043E\u0448\u0435\u043B \u043F\u0435\u0440\u0435\u0435\u0437\u0434?"

    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/14/Elisabeth/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u0421\u043B\u0443\u0448\u0430\u0439, \u043D\u0443 \u0432 \u0442\u0435\u0431\u0435
        \u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u0430 \u0443\u0432\u0435\u0440\u0435\u043D\u0430."

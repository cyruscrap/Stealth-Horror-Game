    - Term: Dialogue System/Conversation/D1_Call_Elisabeth/Entry/16/Elisabeth/Dialogue
        Text
      TermType: 0
      Description: 
      Languages:
      - 
      - "\u041B\u0430\u0434\u043D\u043E, \u042D\u043D\u043D\u0438, \u043C\u043D\u0435

    - target: {fileID: 2528094100606352159, guid: ff790396986a2ad4dab9d03ac114905c, type: 3}
      propertyPath: m_text
      value: "\u0412 \u043F\u0440\u043E\u0448\u043B\u044B\u0435 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435
        \u043F\u0440\u043E\u0448\u043B\u043E \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435
        \u0441 43-\u0445 \u043B\u0435\u0442\u043D\u0435\u0439 \u0414\u0435\u0431\u043E\u0440\u043E\u0439,
        \u0436\u0435\u043D\u043E\u0439 \u0438 \u043C\u0430\u0442\u0435\u0440\u044C\u044E
        \u0434\u0432\u0443\u0445 \u0434\u043E\u0447\u0435\u0440\u0435\u0439. \u041F\u043E\u0441\u043B\u0435
        \u043F\u043E\u0445\u043E\u0440\u043E\u043D \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C
        \u043E\u0442\u0446\u0430 \u0424\u0440\u044D\u043D\u043A\u0430 \u0431\u044B\u043B
        \u043F\u0440\u043E\u0434\u0430\u043D \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439
        \u0434\u043E\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0443\u0441\u043E\u043F\u0448\u0430\u044F
        \u0431\u043E\u0440\u043E\u043B\u0430\u0441\u044C \u0441\u043E \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0439
        \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E, \u043F\u043E\u043A\u0430
        \u0435\u0435 \u043E\u043F\u044F\u0442\u044C \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438
        \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443 \u2014 \u0432 \u044D\u0442\u043E\u0442
        \u0440\u0430\u0437 \u0436\u0434\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
        \u0434\u043D\u044F. \u0412 \u044D\u0442\u0438\u0445 \u0440\u043E\u0434\u043D\u044B\u0445
        \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0441\u0442\u0435\u043D\u0430\u0445
        \u043E\u043D\u0430 \u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430, \u0430
        \u0438\u043D\u043E\u0433\u0434\u0430 \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u043B\u0430\u0441\u044C
        \u043D\u0430\u0434\u0435\u0436\u0434\u043E\u0439, \u0437\u0430\u0442\u0435\u043C
        \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u043B\u0430\u0441\u044C
        \u0432 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0435. \u0418 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F
        \u0438\u0441\u0445\u043E\u0434, \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
        \u0432 \u0434\u043E\u043C\u0435 \u0441\u0442\u0430\u043B\u043E \u043D\u0435\u0432\u044B\u043D\u043E\u0441\u0438\u043C\u043E.
        \u0414\u043E\u043C \u043D\u043E\u043C\u0435\u0440 1428 \u042D\u043B\u043C
        \u0421\u0442\u0440\u0438\u0442 \u043F\u0430\u0440\u0443 \u043B\u0435\u0442
        \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u043B\u0441\u044F \u043F\u043E\u043A\u043E\u0435\u043C.
        \u041E\u0441\u0435\u043D\u044C\u044E 1986 \u0433\u043E\u0434\u0430 \u0435\u043C\u0443
        \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u044C
        \u0432 \u0441\u0432\u043E\u0435 \u043D\u0443\u0442\u0440\u043E \u043D\u043E\u0432\u044B\u0445
        \u0436\u0438\u0442\u0435\u043B\u0435\u0439."
      objectReference: {fileID: 0}
